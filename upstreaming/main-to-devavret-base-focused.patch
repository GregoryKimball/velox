+         const std::shared_ptr<const core::ExchangeNode>& node,
+         const std::shared_ptr<InMemoryExchangeClient>& client)
+          -> std::unique_ptr<Operator> {
+        return std::make_unique<Exchange>(operatorId, ctx, node, client);
+      },
+      [](int32_t operatorId,
+         DriverCtx* ctx,
+         const std::shared_ptr<const core::ExchangeNode>& node,
+         const std::shared_ptr<InMemoryExchangeClient>& /*client*/)
