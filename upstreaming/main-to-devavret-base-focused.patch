+  void subscribe(Completion completion) {
+    std::shared_ptr<const AsyncCompressionResult> readyResult;
+    {
+      std::lock_guard<std::mutex> lock(mutex);
+      if (result) {
+        readyResult = result;
+      } else {
+        completions.push_back(std::move(completion));
+        return;
