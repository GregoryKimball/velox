+#define UCX_CUDA_CHECK(expr)                                 \
+  do {                                                       \
+    cudaError_t err = (expr);                                \
+    if (err != cudaSuccess) {                                \
+      throw std::runtime_error(                              \
+          fmt::format(                                       \
+              "CUDA error in ucx-exchange column codec: {}", \
+              cudaGetErrorString(err)));                     \
+    }                                                        \
+  } while (0)
